	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PHARMACY.jrdax"/>
	<query language="SQL"><![CDATA[SELECT
    medicine_name,
    MAX(stock_quantity) AS stock_quantity,
    MAX(unit_price) AS unit_price
FROM medicines
GROUP BY medicine_name
]]></query>
